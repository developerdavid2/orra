{
  "name": "@orra/payment-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routers": {
      "default": "./src/routers/index.ts"
    },
    ".": {
      "default": "./src/app.ts"
    }
  },
  "main": "dist/serverless.js",
  "scripts": {
    "dev": "PORT=4002 bun run --hot --preload ./src/sentry.preload.ts src/local.ts",
    "build": "tsup",
    "start": "node --import ./dist/sentry.preload.js dist/render.js",
    "check-types": "tsc -b"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@orra/auth": "workspace:*",
    "@orra/redis": "workspace:*",
    "@orra/config": "workspace:*",
    "@orra/db": "workspace:*",
    "@orra/sentry": "workspace:*",
    "@orra/env": "workspace:*",
    "@orra/types": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "^5.8.5",
    "ioredis": "catalog:",
    "bullmq": "catalog:",
    "rate-limiter-flexible": "catalog:",
    "plaid": "^23.0.0",
    "trpc-panel": "^1.3.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsup": "catalog:"
  }
}
