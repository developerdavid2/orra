{
  "name": "@orra/user-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routers": {
      "default": "./src/routers/index.ts"
    },
    ".": {
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "PORT=4001 bun run --hot --preload ./src/sentry.preload.ts src/app.ts",
    "build": "tsup",
    "start": "node --import ./dist/sentry.preload.js dist/app.js",
    "check-types": "tsc -b"
  },
  "dependencies": {
    "@orra/auth": "workspace:*",
    "@orra/config": "workspace:*",
    "@orra/db": "workspace:*",
    "@orra/env": "workspace:*",
    "@orra/file-upload": "workspace:*",
    "@orra/sentry": "workspace:*",
    "@orra/types": "workspace:*",
    "@polar-sh/sdk": "^0.47.0",
    "@trpc/server": "catalog:",
    "@uploadthing/shared": "7.1.8",
    "axios": "^1.18.1",
    "better-auth": "catalog:",
    "cors": "catalog:",
    "country-state-city": "^3.2.1",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "morgan": "catalog:",
    "ua-parser-js": "^2.0.10",
    "uploadthing": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/morgan": "catalog:",
    "@types/cors": "catalog:",
    "typescript": "catalog:",
    "tsup": "catalog:"
  }
}
